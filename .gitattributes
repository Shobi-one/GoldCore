* text=auto

# Unity YAML: merge with Unity's Smart Merge (UnityYAMLMerge) if you set it up locally.
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text eol=lf

*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text

# Binary assets
*.png  binary
*.jpg  binary
*.tif  binary
*.tga  binary
*.psd  binary
*.exr  binary
*.fbx  binary
*.obj  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.dll  binary
*.bin  binary
